--cpu Cortex-M3
"clock timer\startup_stm32f103xb.o"
"clock timer\lcd.o"
"clock timer\main.o"
"clock timer\stm32f1xx_it.o"
"clock timer\stm32f1xx_hal_msp.o"
"clock timer\stm32f1xx_hal_gpio_ex.o"
"clock timer\stm32f1xx_hal_tim.o"
"clock timer\stm32f1xx_hal_tim_ex.o"
"clock timer\stm32f1xx_hal.o"
"clock timer\stm32f1xx_hal_rcc.o"
"clock timer\stm32f1xx_hal_rcc_ex.o"
"clock timer\stm32f1xx_hal_gpio.o"
"clock timer\stm32f1xx_hal_dma.o"
"clock timer\stm32f1xx_hal_cortex.o"
"clock timer\stm32f1xx_hal_pwr.o"
"clock timer\stm32f1xx_hal_flash.o"
"clock timer\stm32f1xx_hal_flash_ex.o"
"clock timer\stm32f1xx_hal_exti.o"
"clock timer\system_stm32f1xx.o"
--strict --scatter "CLOCK TIMER\CLOCK TIMER.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "CLOCK TIMER.map" -o "CLOCK TIMER\CLOCK TIMER.axf"